{
  "name": "@avalon/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "test": "vitest run",
    "test:postgres": "AVALON_REQUIRE_POSTGRES_TESTS=1 vitest run tests/postgres.test.ts tests/postgres-reconnect.test.ts",
    "test:postgres:restart-probe": "tsx tests/support/postgres-restart-probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@avalon/game": "workspace:*",
    "boardgame.io": "0.50.2",
    "koa-body": "^8.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@avalon/test-support": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "socket.io-client": "4.8.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
