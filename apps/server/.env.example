DATABASE_URL=postgresql://avalon:replace-with-password@127.0.0.1:5432/avalon
# The integrated root Compose stack uses these standard PostgreSQL fields
# instead of DATABASE_URL:
# AVALON_STORAGE=postgres
# PGHOST=postgres
# PGPORT=5432
# PGDATABASE=avalon
# PGUSER=avalon
# PGPASSWORD=replace-with-password
# Optional development-only room deletion and lobby seat-kick controls.
# Keep the real token only in ignored .env.local or a secret manager.
# Enter a copy manually in the page only for local testing; the browser copy
# must never be committed, embedded in web config, or persisted.
AVALON_DEV_TOOLS=false
AVALON_DEV_ADMIN_TOKEN=replace-with-a-long-random-local-token
