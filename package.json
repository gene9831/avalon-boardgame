{
  "name": "avalon-boardgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:pull": "git lfs pull --include=images/source/** --exclude=",
    "assets:pull:avatars": "git lfs pull --include=images/source/role-avatars/** --exclude=",
    "assets:pull:roles": "git lfs pull --include=images/source/roles/** --exclude=",
    "assets:setup": "git lfs install --local --skip-smudge",
    "assets:verify": "pnpm --filter @avalon/web test:assets",
    "dev": "pnpm --filter @avalon/web dev",
    "dev:server": "pnpm --filter @avalon/server dev",
    "dev:ui-layout": "pnpm --filter @avalon/ui-layout-lab dev",
    "build": "pnpm --filter @avalon/game typecheck && pnpm --filter @avalon/server typecheck && pnpm --filter @avalon/server build && pnpm --filter @avalon/web build",
    "build:ui-layout": "pnpm --filter @avalon/ui-layout-lab build",
    "lint": "pnpm --filter @avalon/web lint && pnpm --filter @avalon/ui-layout-lab lint",
    "lint:ui-layout": "pnpm --filter @avalon/ui-layout-lab lint",
    "preview": "pnpm --filter @avalon/web preview",
    "test": "pnpm -r --if-present run test",
    "test:ui-layout": "pnpm --filter @avalon/ui-layout-lab test && pnpm --filter @avalon/ui-layout-lab test:e2e",
    "test:e2e": "pnpm --filter @avalon/e2e test:e2e",
    "test:e2e:regression": "pnpm --filter @avalon/e2e test:e2e:regression",
    "test:e2e:smoke": "pnpm --filter @avalon/e2e test:e2e:smoke",
    "test:e2e:matrix": "pnpm --filter @avalon/e2e test:e2e:matrix",
    "test:postgres": "pnpm --filter @avalon/server test:postgres",
    "test:replay": "pnpm --filter @avalon/test-support replay --",
    "typecheck": "pnpm --filter @avalon/game typecheck && pnpm --filter @avalon/test-support typecheck && pnpm --filter @avalon/server typecheck && pnpm --filter @avalon/web exec tsc -b && pnpm --filter @avalon/e2e typecheck && pnpm --filter @avalon/ui-layout-lab typecheck"
  }
}
