# Bind to loopback when a host reverse proxy fronts Avalon.
# Use 0.0.0.0 only when clients should connect directly over the LAN.
AVALON_BIND_ADDRESS=127.0.0.1
AVALON_PORT=8080

# Comma-separated browser origins. Include scheme and optional port, never a path.
AVALON_ORIGINS=http://localhost:8080

POSTGRES_DB=avalon
POSTGRES_USER=avalon
# Required: replace before startup. Do not commit the resulting .env file.
POSTGRES_PASSWORD=

# No ./ prefix means a Docker named volume.
# Set ./data or an absolute path to use a host bind mount instead.
AVALON_POSTGRES_DATA=avalon-postgres-data
